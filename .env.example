# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MTN Rwanda MoMo Collections Production Configuration
# Set these in Vercel / Cloud Run Environment Variables:
MTN_API_USER="production_api_user_uuid_here"
MTN_API_KEY="production_api_key_secret_here"
MTN_SUBSCRIPTION_KEY="production_ocp_apim_subscription_key_here"
MTN_TARGET_ENVIRONMENT="mtnrwanda"
MTN_API_BASE_URL="https://proxy.momoapi.mtn.com"
MTN_CALLBACK_URL="https://bestflim.vercel.app/api/mtn/callback"

